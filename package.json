{
  "name": "bitmask",
  "version": "1.0.0",
  "description": "Anonymous encrypted peer-to-peer chat with self-destructing messages",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "android:sync": "npx cap sync android",
    "android:build": "npm run android:sync && npx cap build android",
    "android:open": "npx cap open android",
    "android:doctor": "npx cap doctor"
  },
  "keywords": [
    "anonymous",
    "chat",
    "encrypted",
    "e2ee",
    "websocket"
  ],
  "license": "MIT",
  "overrides": {
    "qs": "6.16.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
